<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas del respaldo automático de Google (Android Auto Backup).
     Rutas relativas al dominio: "file" es la carpeta de datos de la app
     (donde path_provider deja getApplicationDocumentsDirectory = app_flutter/).
     Referencia: https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <!-- Base de datos SQLite (getDatabasesPath -> databases/) -->
    <include domain="database" path="pet_pal_v2.db" />

    <!-- Fotos y PDFs adjuntos (getApplicationDocumentsDirectory -> app_flutter/) -->
    <include domain="file" path="app_flutter/petpal_files/" />

    <!-- Preferencias de shared_preferences (tema, etc.) -->
    <include domain="sharedpref" path="FlutterSharedPreferences.xml" />

    <!-- Archivos restaurados temporalmente: no hace falta respaldarlos -->
    <exclude domain="file" path="app_flutter/petpal_restored_files/" />
</full-backup-content>
